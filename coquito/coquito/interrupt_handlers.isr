#include "ktypes.h"
#include "interrupt_handlers.h"
#include "serial.h"

struct __attribute__((packed)) interrupt_frame {
    u64 ip;
    u64 cs;
    u64 flags;
    u64 sp;
};
typedef struct interrupt_frame interrupt_frame_t;

/** Vector #0 */
__attribute__((interrupt)) void int_handler__division_error(void* iframe){
    (void)iframe;
    serial_puts("#DE\n");
    return;
}

/** Vector #1 */
__attribute__((interrupt)) void int_handler__debug(void* iframe){
    (void)iframe;
    serial_puts("#DB\n");
    return;
}

