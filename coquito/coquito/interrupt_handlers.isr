/** Vector #13 */
__attribute__((interrupt)) void int_handler__general_protection_fault(void* iframe){
    (void)iframe;
    serial_puts("#GP\n");
    serial_putchar(033);
    serial_puts("[31m");
    serial_puts("Hanging after #GP...\n");
    serial_putchar(033);
    serial_puts("[39m");
    while(1){}
    return;
}

