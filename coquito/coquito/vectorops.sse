void ex_vfmaddsub231ps(const float *a,
                                     const float *b,
                                     const float *c,
                                     float *out)
{
    asm volatile(
        "vmovups            (%[a]), %%ymm0\n\t"
        "vmovups            (%[b]), %%ymm1\n\t"
        "vmovups            (%[c]), %%ymm2\n\t"
        "vfmaddsub231ps     %%ymm2, %%ymm1, %%ymm0\n\t"
        "vmovups            %%ymm0, (%[out])\n\t"
        "vzeroupper\n\t"
        :
        : [a]"r"(a), [b]"r"(b), [c]"r"(c), [out]"r"(out)
        : "ymm0", "ymm1", "ymm2", "memory"
    );
}

void ex_vperm2i128(const int *a, const int *b, int *out)
{
    asm volatile(
        "vmovdqu    (%[a]), %%ymm1\n\t"
        "vmovdqu    (%[b]), %%ymm2\n\t"
        "vperm2i128 $0x21, %%ymm2, %%ymm1, %%ymm0\n\t"
        "vmovdqu    %%ymm0, (%[out])\n\t"
        "vzeroupper\n\t"
        :
        : [a]"r"(a), [b]"r"(b), [out]"r"(out)
        : "ymm0", "ymm1", "ymm2", "memory"
    );
}

void ex_vpsllvd(const int *src, const int *counts, int *out)
{
    asm volatile(
        "vmovdqu  (%[src]), %%ymm1\n\t"
        "vmovdqu  (%[cnt]), %%ymm2\n\t"
        "vpsllvd  %%ymm2, %%ymm1, %%ymm0\n\t"
        "vmovdqu  %%ymm0, (%[out])\n\t"
        "vzeroupper\n\t"
        :
        : [src]"r"(src), [cnt]"r"(counts), [out]"r"(out)
        : "ymm0", "ymm1", "ymm2", "memory"
    );
}

void ex_vpalignr(const unsigned char *a,
                               const unsigned char *b,
                               unsigned char *out)
{
    asm volatile(
        "vmovdqu   (%[a]), %%ymm1\n\t"
        "vmovdqu   (%[b]), %%ymm2\n\t"
        "vpalignr  $8, %%ymm2, %%ymm1, %%ymm0\n\t"
        "vmovdqu   %%ymm0, (%[out])\n\t"
        "vzeroupper\n\t"
        :
        : [a]"r"(a), [b]"r"(b), [out]"r"(out)
        : "ymm0", "ymm1", "ymm2", "memory"
    );
}