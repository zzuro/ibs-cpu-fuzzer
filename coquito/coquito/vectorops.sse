                                 const signed char *b,
                                 short *out)
{
    asm volatile(
        "vmovdqu     (%[a]), %%ymm1\n\t"
        "vmovdqu     (%[b]), %%ymm2\n\t"
        "vpmaddubsw  %%ymm2, %%ymm1, %%ymm0\n\t"
        "vmovdqu     %%ymm0, (%[out])\n\t"
        "vzeroupper\n\t"
        :
        : [a]"r"(a), [b]"r"(b), [out]"r"(out)
        : "ymm0", "ymm1", "ymm2", "memory"
    );
}

void ex_vpmaddwd(const short *a, const short *b, int *out)
{
    asm volatile(
        "vmovdqu   (%[a]), %%ymm1\n\t"
        "vmovdqu   (%[b]), %%ymm2\n\t"
        "vpmaddwd  %%ymm2, %%ymm1, %%ymm0\n\t"
